#include <iostream>
#include <string>

using namespace std;

int main() {

    // =========================================================
    // SISTEMA DE REGISTRO E GESTÃO DE CONTAS BANCÁRIAS
    // INF101 - Programação de Computadores I
    // Etapa 1
    // =========================================================

    // Quantidade máxima de contas permitidas
    const int MAX_CONTAS = 5;

    // ---------------------------------------------------------
    // Variáveis para armazenar os dados das contas
    // ---------------------------------------------------------

    int numeroConta[MAX_CONTAS];
    string nomeCliente[MAX_CONTAS];
    string cpf[MAX_CONTAS];
    int tipoConta[MAX_CONTAS];
    double saldo[MAX_CONTAS];
    bool contaAtiva[MAX_CONTAS];

    // Quantidade de contas cadastradas
    int quantidadeContas = 0;

    // Variáveis auxiliares
    int opcao;
    int contaSelecionada;
    int novaTipo;

    // ---------------------------------------------------------
    // Inicialização das contas
    // ---------------------------------------------------------

    for (int i = 0; i < MAX_CONTAS; i++) {
        numeroConta[i] = 0;
        nomeCliente[i] = "";
        cpf[i] = "";
        tipoConta[i] = 0;
        saldo[i] = 0.0;
        contaAtiva[i] = false;
    }

    // ---------------------------------------------------------
    // MENU PRINCIPAL
    // ---------------------------------------------------------

    do {

        cout << "\n";
        cout << "========================================\n";
        cout << "          BANCO VEKTOR INF101\n";
        cout << "========================================\n";
        cout << "1 - Cadastrar conta\n";
        cout << "2 - Consultar conta\n";
        cout << "3 - Verificar saldo\n";
        cout << "4 - Alterar tipo da conta\n";
        cout << "5 - Ativar/Desativar conta\n";
        cout << "6 - Sair\n";
        cout << "========================================\n";
        cout << "Digite uma opcao: ";
        cin >> opcao;

        // -----------------------------------------------------
        // SWITCH DO MENU
        // -----------------------------------------------------

        switch (opcao) {

            // =================================================
            // OPÇÃO 1 - CADASTRAR CONTA
            // =================================================

            case 1: {

                // Verifica se já atingiu o limite de contas
                if (quantidadeContas >= MAX_CONTAS) {

                    cout << "\nLimite maximo de "
                         << MAX_CONTAS
                         << " contas atingido!\n";

                } else {

                    int posicao = quantidadeContas;

                    cout << "\n========================================\n";
                    cout << "          CADASTRO DE CONTA\n";
                    cout << "========================================\n";

                    // Número da conta
                    do {
                        cout << "Digite o numero da conta: ";
                        cin >> numeroConta[posicao];

                        if (numeroConta[posicao] <= 0) {
                            cout << "Erro: o numero da conta deve ser maior que zero.\n";
                        }

                    } while (numeroConta[posicao] <= 0);

                    // Nome do cliente
                    cin.ignore();

                    cout << "Digite o nome do cliente: ";
                    getline(cin, nomeCliente[posicao]);

                    // CPF
                    cout << "Digite o CPF do cliente: ";
                    getline(cin, cpf[posicao]);

                    // Tipo da conta
                    do {

                        cout << "\nTipo da conta:\n";
                        cout << "1 - Conta Corrente\n";
                        cout << "2 - Conta Poupanca\n";
                        cout << "Digite o tipo da conta: ";
                        cin >> tipoConta[posicao];

                        if (tipoConta[posicao] != 1 &&
                            tipoConta[posicao] != 2) {

                            cout << "Erro: escolha 1 para Corrente "
                                 << "ou 2 para Poupanca.\n";
                        }

                    } while (tipoConta[posicao] != 1 &&
                             tipoConta[posicao] != 2);

                    // Saldo inicial
                    do {

                        cout << "Digite o saldo inicial: R$ ";
                        cin >> saldo[posicao];

                        if (saldo[posicao] < 0) {
                            cout << "Erro: o saldo nao pode ser negativo.\n";
                        }

                    } while (saldo[posicao] < 0);

                    // Toda conta começa ativa
                    contaAtiva[posicao] = true;

                    // Aumenta a quantidade de contas cadastradas
                    quantidadeContas++;

                    cout << "\nConta cadastrada com sucesso!\n";
                    cout << "Numero da conta: "
                         << numeroConta[posicao] << "\n";
                }

                break;
            }

            // =================================================
            // OPÇÃO 2 - CONSULTAR CONTA
            // =================================================

            case 2: {

                if (quantidadeContas == 0) {

                    cout << "\nNenhuma conta cadastrada.\n";

                } else {

                    cout << "\nDigite o numero da conta: ";
                    cin >> contaSelecionada;

                    int posicao = -1;

                    // Procura a conta
                    for (int i = 0; i < quantidadeContas; i++) {

                        if (numeroConta[i] == contaSelecionada) {
                            posicao = i;
                        }
                    }

                    if (posicao == -1) {

                        cout << "\nConta nao encontrada.\n";

                    } else {

                        cout << "\n========================================\n";
                        cout << "          DADOS DA CONTA\n";
                        cout << "========================================\n";

                        cout << "Numero da conta: "
                             << numeroConta[posicao] << "\n";

                        cout << "Nome do cliente: "
                             << nomeCliente[posicao] << "\n";

                        cout << "CPF: "
                             << cpf[posicao] << "\n";

                        cout << "Tipo da conta: ";

                        if (tipoConta[posicao] == 1) {
                            cout << "Corrente\n";
                        } else {
                            cout << "Poupanca\n";
                        }

                        cout << "Saldo: R$ "
                             << saldo[posicao] << "\n";

                        cout << "Status: ";

                        if (contaAtiva[posicao]) {
                            cout << "Ativa\n";
                        } else {
                            cout << "Inativa\n";
                        }

                        cout << "========================================\n";
                    }
                }

                break;
            }

            // =================================================
            // OPÇÃO 3 - VERIFICAR SALDO
            // =================================================

            case 3: {

                if (quantidadeContas == 0) {

                    cout << "\nNenhuma conta cadastrada.\n";

                } else {

                    cout << "\nDigite o numero da conta: ";
                    cin >> contaSelecionada;

                    int posicao = -1;

                    // Procura a conta
                    for (int i = 0; i < quantidadeContas; i++) {

                        if (numeroConta[i] == contaSelecionada) {
                            posicao = i;
                        }
                    }

                    if (posicao == -1) {

                        cout << "\nConta nao encontrada.\n";

                    } else if (!contaAtiva[posicao]) {

                        // Operação depende de conta ativa
                        cout << "\nA conta esta inativa.\n";
                        cout << "Nao e possivel consultar o saldo.\n";

                    } else {

                        cout << "\n========================================\n";
                        cout << "              SALDO\n";
                        cout << "========================================\n";

                        cout << "Conta: "
                             << numeroConta[posicao] << "\n";

                        cout << "Cliente: "
                             << nomeCliente[posicao] << "\n";

                        cout << "Saldo atual: R$ "
                             << saldo[posicao] << "\n";

                        cout << "========================================\n";
                    }
                }

                break;
            }

            // =================================================
            // OPÇÃO 4 - ALTERAR TIPO DA CONTA
            // =================================================

            case 4: {

                if (quantidadeContas == 0) {

                    cout << "\nNenhuma conta cadastrada.\n";

                } else {

                    cout << "\nDigite o numero da conta: ";
                    cin >> contaSelecionada;

                    int posicao = -1;

                    // Procura a conta
                    for (int i = 0; i < quantidadeContas; i++) {

                        if (numeroConta[i] == contaSelecionada) {
                            posicao = i;
                        }
                    }

                    if (posicao == -1) {

                        cout << "\nConta nao encontrada.\n";

                    } else if (!contaAtiva[posicao]) {

                        cout << "\nA conta esta inativa.\n";
                        cout << "Nao e possivel alterar o tipo.\n";

                    } else {

                        do {

                            cout << "\nNovo tipo da conta:\n";
                            cout << "1 - Conta Corrente\n";
                            cout << "2 - Conta Poupanca\n";
                            cout << "Digite o novo tipo: ";
                            cin >> novaTipo;

                            if (novaTipo != 1 &&
                                novaTipo != 2) {

                                cout << "Erro: tipo invalido.\n";
                            }

                        } while (novaTipo != 1 &&
                                 novaTipo != 2);

                        tipoConta[posicao] = novaTipo;

                        cout << "\nTipo da conta alterado com sucesso!\n";
                    }
                }

                break;
            }

            // =================================================
            // OPÇÃO 5 - ATIVAR/DESATIVAR CONTA
            // =================================================

            case 5: {

                if (quantidadeContas == 0) {

                    cout << "\nNenhuma conta cadastrada.\n";

                } else {

                    cout << "\nDigite o numero da conta: ";
                    cin >> contaSelecionada;

                    int posicao = -1;

                    // Procura a conta
                    for (int i = 0; i < quantidadeContas; i++) {

                        if (numeroConta[i] == contaSelecionada) {
                            posicao = i;
                        }
                    }

                    if (posicao == -1) {

                        cout << "\nConta nao encontrada.\n";

                    } else {

                        // Inverte o estado atual da conta
                        contaAtiva[posicao] = !contaAtiva[posicao];

                        if (contaAtiva[posicao]) {

                            cout << "\nConta ativada com sucesso!\n";

                        } else {

                            cout << "\nConta desativada com sucesso!\n";
                        }
                    }
                }

                break;
            }

            // =================================================
            // OPÇÃO 6 - SAIR
            // =================================================

            case 6:

                cout << "\n========================================\n";
                cout << "Obrigado por utilizar o Banco Vektor!\n";
                cout << "Programa encerrado.\n";
                cout << "========================================\n";

                break;

            // =================================================
            // OPÇÃO INVÁLIDA
            // =================================================

            default:

                cout << "\nOpcao invalida!\n";
                cout << "Digite uma opcao de 1 a 6.\n";

                break;
        }

    } while (opcao != 6);

    return 0;
}
